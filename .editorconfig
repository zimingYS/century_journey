root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust：与 rustfmt.toml 对齐（edition 2024 / max_width 100 / 4 空格）
# 编辑器只做「辅助」，最终以 cargo fmt 为准
[*.rs]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,toml,json}]
indent_size = 2

# Markdown 行尾双空格是硬换行，不裁剪
[*.md]
trim_trailing_whitespace = false
